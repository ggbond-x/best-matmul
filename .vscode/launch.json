{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gemm_fast",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/gemm_fast",
      "args": ["256", "256", "64", "N", "T", "3", "event", "1", "1", "2"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
